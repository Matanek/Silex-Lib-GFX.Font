use GFX.Font

func main() {
    let bytes = embed_bytes("../Tests/Fixtures/Minimal.ttf")
    var cycle = 0
    while cycle < 2 {
        match Font.Face.try_open(bytes) {
            failure(error) => { panic(error.detail) }
            success(face) => {
                assert(face.family_name() == "Noto Sans")
                assert(face.capabilities().shaping)
                assert(face.close())
                assert(!face.close())
            }
        }
        cycle++
    }
}
