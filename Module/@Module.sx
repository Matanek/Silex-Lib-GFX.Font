public enum ErrorKind {
    file_read
    empty_data
    invalid_data
    face_index_out_of_range
    invalid_size
    invalid_density
    invalid_padding
    coverage_too_large
    invalid_tag
    invalid_text
    invalid_language
    invalid_feature_range
    invalid_placement
    unknown_axis
    duplicate_axis
    variation_out_of_range
    out_of_memory
    unsupported
    unavailable
    abi_mismatch
    native_failure
}

public struct Error { let kind:ErrorKind; let detail:str }

public enum OutlineKind { none; quadratic; cubic }

