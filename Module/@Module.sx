        self.cache_coverage = cache_coverage
        self.text = text
        self.direction = direction
        self.script = script
        self.language = language
        self.glyphs = glyphs
        self.metrics = metrics
    }
}

struct ShapeCacheEntry { let key:str; let data:GlyphRunData }

class ShapeCache {
    private var entries:ShapeCacheEntry[] = []
    private var cursor:int = 0

    func find(key:str) GlyphRunData? {
        for entry in self.entries {
            if entry.key == key { return entry.data }
        }
        return null
    }

    func insert(key:str, data:GlyphRunData) {
        let entry = ShapeCacheEntry(key:key, data:data)
        if self.entries.count() < 64 {
            self.entries.append(entry)
        } else {
            self.entries[self.cursor] = entry
            self.cursor = (self.cursor + 1) % 64
        }
    }
}

struct OutlineCacheEntry { let glyph_id:uint32; let outline:GlyphOutline? }

class OutlineCache {
    private var entries:OutlineCacheEntry[] = []
    private var slots:int[]

    init() {
        self.slots = outline_cache_slots(512)
    }

    func find(glyph_id:uint32) OutlineCacheEntry? {
        let slot = (glyph_id as uint % self.slots.count() as uint) as int
        let index = self.slots[slot]
        if index >= 0 && self.entries[index].glyph_id == glyph_id {
            return self.entries[index]
        }
        return null
    }

    func insert(glyph_id:uint32, outline:GlyphOutline?) {
        let entry = OutlineCacheEntry(glyph_id:glyph_id, outline:outline)
        let slot = (glyph_id as uint % self.slots.count() as uint) as int
        let index = self.slots[slot]
        if index >= 0 {
            self.entries.replace(index, entry)
            return
        }
        self.slots.replace(slot, self.entries.count())
        self.entries.append(entry)
    }
}

func outline_cache_slots(count:int) int[] {
    var result:int[] = []
    while result.count() < count { result.append(-1) }
    return result
}

struct CoverageCacheEntry { let key:str; let coverage:Coverage; let byte_count:int }

class CoverageCache {
    private var entries:CoverageCacheEntry[] = []
    private var bytes:int = 0

    func find(key:str) Coverage? {
        for entry in self.entries {
            if entry.key == key { return entry.coverage }
        }
        return null
    }

    func insert(key:str, coverage:Coverage) {
        let byte_count = coverage.byte_count() + key.count() + 128
        if byte_count > 8388608 { return }
        while self.entries.count() > 0 && self.bytes + byte_count > 8388608 {
            self.discard_oldest()
        }
        self.entries.append(CoverageCacheEntry(
            key:key,
            coverage:coverage,
            byte_count:byte_count
        ))
        self.bytes += byte_count
    }

    private func discard_oldest() {
        if self.entries.count() == 0 { return }
        self.bytes -= self.entries[0].byte_count
        var retained:CoverageCacheEntry[] = []
        var index = 1
        while index < self.entries.count() {
            retained.append(self.entries[index])
            index++
        }
        self.entries = retained
    }

    func byte_count() int { return self.bytes }
    func entry_count() int { return self.entries.count() }
}
struct ValidatedShape {
    let key:str
    let direction:int
    let script:str
    let language:str
