public enum Hinting { none; light; normal }
public enum Antialiasing { grayscale; monochrome }

public struct RasterOptions {
    let density:float64
    let hinting:Hinting
    let antialiasing:Antialiasing
    let padding:int
    let maximum_pixels:int

    init(
        density:float64 = 1.0,
        hinting:Hinting = Hinting.normal(),
        antialiasing:Antialiasing = Antialiasing.grayscale(),
        padding:int = 0,
        maximum_pixels:int = 16777216
    ) {
        self.density = density
        self.hinting = hinting
        self.antialiasing = antialiasing
        self.padding = padding
        self.maximum_pixels = maximum_pixels
    }
}

public struct PixelPosition { let x:int; let y:int }

public struct GlyphRasterOptions {
    let density:float64
    let hinting:Hinting
    let antialiasing:Antialiasing

    init(
        density:float64 = 1.0,
        hinting:Hinting = Hinting.normal(),
        antialiasing:Antialiasing = Antialiasing.grayscale()
    ) {
        self.density = density
        self.hinting = hinting
        self.antialiasing = antialiasing
    }
}

public struct GlyphCoverage {
    private let packed_alpha_value:str
    let width:int
    let height:int
    let stride:int
    let left:int
    let top:int
    let density:float64

    module init(
        packed_alpha:str,
        width:int,
        height:int,
        stride:int,
        left:int,
        top:int,
        density:float64
    ) {
        self.packed_alpha_value = packed_alpha
        self.width = width
        self.height = height
        self.stride = stride
        self.left = left
        self.top = top
        self.density = density
    }

    func is_empty() bool { return self.width == 0 || self.height == 0 }
    func byte_count() int { return self.stride * self.height }
    func packed_alpha() str { return self.packed_alpha_value }
    func alpha() uint8[] {
        var result:uint8[] = []
        var index = 0
        while index < self.byte_count() {
            result.append(C.byte_at(self.packed_alpha_value, index as C.Size))
            index++
        }
        return result
    }
}

public struct Coverage {
    private let packed_alpha_value:str
    let width:int
    let height:int
    let stride:int
    let origin:PixelPosition
    let baseline:int
    let bounds:Bounds
    let advance:Position
    let density:float64

    module init(
        packed_alpha:str,
        width:int,
        height:int,
        stride:int,
        origin:PixelPosition,
        baseline:int,
        bounds:Bounds,
        advance:Position,
        density:float64
    ) {
        self.packed_alpha_value = packed_alpha
        self.width = width
        self.height = height
        self.stride = stride
        self.origin = origin
        self.baseline = baseline
        self.bounds = bounds
        self.advance = advance
        self.density = density
    }

    func is_empty() bool { return self.width == 0 || self.height == 0 }
    func byte_count() int { return self.stride * self.height }
    func packed_alpha() str { return self.packed_alpha_value }
    func alpha() uint8[] {
        var result:uint8[] = []
        var index = 0
        while index < self.byte_count() {
            result.append(C.byte_at(self.packed_alpha_value, index as C.Size))
            index++
        }
        return result
    }
}

