}

public class Face {
    private var library_handle:uint
    private var face_handle:uint
    private let stable_identity:str

    private init(data:Native.FaceData, identity:str) {
        self.library_handle = data.library
        self.face_handle = data.face
        self.stable_identity = identity
    }

    drop {
        if self.face_handle != 0 as uint {
            Native.close_face(self.library_handle, self.face_handle)
            self.face_handle = 0 as uint
            self.library_handle = 0 as uint
        }
    }

    static func decode(bytes:uint8[], face_index:int = 0) Result<Face, Error> {
        match Native.open(bytes, face_index) {
            failure(error) => { return Result<Face, Error>.failure(public_error(error)) }
            success(data) => {
                let digest = Crypto.sha256(@bytes[0:bytes.count()])
                return Result<Face, Error>.success(Face(data, digest + "#$(face_index)"))
            }
        }
    }

    private static func bundled(bytes:uint8[], digest:str) Result<Face, Error> {
        match Native.open(bytes, 0) {
            failure(error) => { return Result<Face, Error>.failure(public_error(error)) }
            success(data) => {
                return Result<Face, Error>.success(Face(data, digest + "#0"))
            }
        }
    }

    static func try_open(bytes:uint8[], index:int = 0) Result<Face, Error> {
        return Face.decode(bytes, face_index:index)
    }

    static func open(path:Path, face_index:int = 0, maximum_bytes:int = 67108864) Result<Face, Error> {
        match File.read_all(path, maximum_bytes) {
            failure(error) => {
                return Result<Face, Error>.failure(Error(
                    kind:ErrorKind.file_read,
                    detail:error.detail
                ))
            }
            success(bytes) => { return Face.decode(bytes, face_index:face_index) }
        }
    }

    static func default() Result<Face, Error> {
        return Face.bundled(
            embed_bytes("../Assets/Fonts/NotoSans.ttf"),
            "bfb7bb691513f12e734dc346c03a03f784912432d7e3fa8e56efcf906fe86b3d"
        )
    }

    static func monospace() Result<Face, Error> {
        return Face.bundled(
            embed_bytes("../Assets/Fonts/NotoSansMono-Regular.ttf"),
            "65b5e2b2c4a1fba9ae8be1f026cb35b03dcb8886d9b2a4147054fde12f7e767d"
        )
    }

    static func pixel() Result<Face, Error> {
        return Face.bundled(
            embed_bytes("../Assets/Fonts/DepartureMono-Regular.otf"),
            "4d53f663155cf8bf7ffc8e688776e719625f7bbb80a8d90073438b249261a2e0"
        )
    }

    func identity() str { return self.stable_identity }
    func index() int { return Native.index(self.face_handle) }
    func face_count() int { return Native.count(self.face_handle) }
    func glyph_count() int { return Native.glyph_count(self.face_handle) }
    func units_per_em() int { return Native.units_per_em(self.face_handle) }
    func family_name() str? { return optional_text(Native.family_name(self.face_handle)) }
    func subfamily_name() str? { return optional_text(Native.subfamily_name(self.face_handle)) }
    func postscript_name() str? { return optional_text(Native.postscript_name(self.face_handle)) }
    func supports(scalar:uint32) bool { return Native.supports_scalar(self.face_handle, scalar) }

    func capabilities() Capabilities {
        let value = Native.capabilities(self.face_handle)
        return Capabilities(
            outlines:(value & (1 as uint)) != 0 as uint,
            shaping:(value & (2 as uint)) != 0 as uint,
            variations:(value & (4 as uint)) != 0 as uint,
            color:(value & (8 as uint)) != 0 as uint
        )
    }

    func outline_kind() OutlineKind {
        let kind = Native.outline_kind(self.face_handle)
        if kind == 1 { return OutlineKind.quadratic() }
        if kind == 2 { return OutlineKind.cubic() }
        return OutlineKind.none()
    }

    func metrics() Metrics {
        let upem = self.units_per_em()
        let scale = upem as float64
        return Metrics(
            units_per_em:upem,
            ascender:Native.ascender(self.face_handle) as float64 / scale,
            descender:Native.descender(self.face_handle) as float64 / scale,
            line_gap:Native.line_gap(self.face_handle) as float64 / scale,
            line_height:Native.line_height(self.face_handle) as float64 / scale,
            underline_position:Native.underline_position(self.face_handle) as float64 / scale,
            underline_thickness:Native.underline_thickness(self.face_handle) as float64 / scale,
            strikeout_position:Native.strikeout_position(self.face_handle) as float64 / scale,
            strikeout_thickness:Native.strikeout_thickness(self.face_handle) as float64 / scale
        )
    }

    func axes() Axis[] {
        var result:Axis[] = []
        var index = 0
        while index < Native.axis_count(self.face_handle) {
            result.append(Axis(
                tag:Native.axis_tag(self.face_handle, index),
                name:optional_text(Native.axis_name(self.face_handle, index)),
                minimum:Native.axis_minimum(self.face_handle, index),
                default_value:Native.axis_default(self.face_handle, index),
                maximum:Native.axis_maximum(self.face_handle, index)
            ))
            index++
        }
        return result
    }

    func named_instances() NamedInstance[] {
        let axes = self.axes()
        var result:NamedInstance[] = []
        var instance_index = 0
        while instance_index < Native.named_instance_count(self.face_handle) {
            var variations:Variation[] = []
            var axis_index = 0
            while axis_index < axes.count() {
                variations.append(Variation(
                    axes[axis_index].tag,
                    Native.named_instance_coordinate(self.face_handle, instance_index, axis_index)
                ))
                axis_index++
            }
            result.append(NamedInstance(
                name:optional_text(Native.named_instance_name(self.face_handle, instance_index)),
                postscript_name:optional_text(Native.named_instance_postscript_name(self.face_handle, instance_index)),
                variations:variations
            ))
            instance_index++
        }
        return result
    }

    package func native_handle() uint { return self.face_handle }
    package func native_outline_decomposition_count() int {
        return Native.face_outline_decomposition_count(self.face_handle)
    }
    package func native_bitmap_rasterization_count() int {
        return Native.face_bitmap_rasterization_count(self.face_handle)
    }
    package func native_bitmap_cache_entry_count() int {
        return Native.face_bitmap_cache_entry_count(self.face_handle)
    }
    package func native_bitmap_cache_byte_count() int {
        return Native.face_bitmap_cache_byte_count(self.face_handle)
    }
}

public class Instance {
    private var face_value:Face
    private var instance_handle:uint
    private let logical_size:float64
    private let effective_variations:Variation[]
    private let requested_synthesis:Synthesis
    private let stable_identity:str
    private var shaping_cache:ShapeCache
    private var outline_cache:OutlineCache
    private var coverage_cache:CoverageCache

    private init(
        face:Face,
        handle:uint,
        size:float64,
        variations:Variation[],
        synthesis:Synthesis,
        identity:str
    ) {
        self.face_value = face
        self.instance_handle = handle
        self.logical_size = size
        self.effective_variations = variations
        self.requested_synthesis = synthesis
        self.stable_identity = identity
        self.shaping_cache = ShapeCache()
        self.outline_cache = OutlineCache()
        self.coverage_cache = CoverageCache()
    }

    drop {
        if self.instance_handle != 0 as uint {
            Native.close_instance(self.instance_handle)
            self.instance_handle = 0 as uint
        }
    }

    static func create(
        face:Face,
        size:float64,
        variations:Variation[] = [],
        synthesis:Synthesis = Synthesis()
    ) Result<Instance, Error> {
        if size <= 0.0 || !Math.is_finite(size) {
            return Result<Instance, Error>.failure(Error(
                kind:ErrorKind.invalid_size,
                detail:"font instance size must be positive and finite"
            ))
        }
        match validated_variations(face, variations) {
            failure(error) => { return Result<Instance, Error>.failure(error) }
            success(effective) => {
                match Native.create_instance(face.native_handle()) {
                    failure(error) => { return Result<Instance, Error>.failure(public_error(error)) }
                    success(handle) => {
                        for variation in effective {
                            match Native.set_variation(handle, Native.tag(variation.tag), variation.value) {
                                failure(error) => {
                                    Native.close_instance(handle)
                                    return Result<Instance, Error>.failure(public_error(error))
                                }
                                success => {}
                            }
                        }
                        let identity = instance_identity(face, size, effective, synthesis)
                        return Result<Instance, Error>.success(Instance(
                            face, handle, size, effective, synthesis, identity
                        ))
                    }
                }
            }
        }
    }

    func face() Face { return self.face_value }
    func size() float64 { return self.logical_size }
    func variations() Variation[] { return self.effective_variations }
    func synthesis() Synthesis { return self.requested_synthesis }
    func identity() str { return self.stable_identity }

    func metrics() Metrics {
        let value = self.face_value.metrics()
        let scale = self.logical_size
        return Metrics(
            units_per_em:value.units_per_em,
            ascender:value.ascender * scale,
            descender:value.descender * scale,
            line_gap:value.line_gap * scale,
            line_height:value.line_height * scale,
            underline_position:value.underline_position * scale,
            underline_thickness:value.underline_thickness * scale,
            strikeout_position:value.strikeout_position * scale,
            strikeout_thickness:value.strikeout_thickness * scale
        )
    }

    func scalar_bounds(scalar:uint32) Bounds? {
        if value = Native.scalar_bounds(self.instance_handle, scalar, self.face_value.units_per_em()) {
            return Bounds(
                x:value.x * self.logical_size,
                y:value.y * self.logical_size,
                width:value.width * self.logical_size,
                height:value.height * self.logical_size
            )
        }
        return null
    }

    func rasterize_glyph(
        glyph_id:uint32,
        options:GlyphRasterOptions = GlyphRasterOptions()
    ) Result<GlyphCoverage?, Error> {
        let physical_size_value = self.logical_size * options.density * 64.0
        if options.density <= 0.0 || !Math.is_finite(options.density) ||
            !Math.is_finite(physical_size_value) ||
            physical_size_value < 1.0 || physical_size_value > 1048576.0
        {
            return Result<GlyphCoverage?, Error>.failure(Error(
                kind:ErrorKind.invalid_density,
                detail:"font glyph raster density must fit the supported 1/64-pixel range"
            ))
        }
        match Native.raster_glyph(
            self.instance_handle,
            glyph_id,
            Math.round(physical_size_value) as int,
            hinting_code(options.hinting),
            antialiasing_code(options.antialiasing)
        ) {
            failure(error) => {
                return Result<GlyphCoverage?, Error>.failure(public_error(error))
            }
            success(bitmap) => {
                if value = bitmap {
                    return Result<GlyphCoverage?, Error>.success(GlyphCoverage(
                        packed_alpha:value.pixels,
                        width:value.width,
                        height:value.height,
                        stride:value.stride,
                        left:value.left,
                        top:value.top,
                        density:options.density
                    ))
                }
                return Result<GlyphCoverage?, Error>.success(null)
            }
        }
    }

    func outline(glyph_id:uint32) Result<GlyphOutline?, Error> {
        if cached = self.outline_cache.find(glyph_id) {
            return Result<GlyphOutline?, Error>.success(cached.outline)
        }
        match Native.outline(self.instance_handle, glyph_id) {
            failure(error) => { return Result<GlyphOutline?, Error>.failure(public_error(error)) }
            success(data) => {
                if value = data {
                    let outline = normalized_outline(
                        glyph_id,
                        value,
                        self.face_value.units_per_em()
                    )
                    self.outline_cache.insert(glyph_id, outline)
                    return Result<GlyphOutline?, Error>.success(outline)
                }
                self.outline_cache.insert(glyph_id, null)
                return Result<GlyphOutline?, Error>.success(null)
            }
        }
    }

    func shape(text:str, options:ShapeOptions = ShapeOptions()) Result<GlyphRun, Error> {
        match validated_shape(text, options) {
            failure(error) => { return Result<GlyphRun, Error>.failure(error) }
            success(validated) => {
                if cached = self.shaping_cache.find(validated.key) {
                    return Result<GlyphRun, Error>.success(GlyphRun(self, cached))
                }
                match Native.shape(
                    self.instance_handle,
                    text,
                    validated.direction,
                    validated.script,
                    validated.language,
                    validated.features
                ) {
                    failure(error) => { return Result<GlyphRun, Error>.failure(public_error(error)) }
                    success(shaped) => {
                        let data = glyph_run_data(self, validated.key, text, shaped)
                        self.shaping_cache.insert(validated.key, data)
                        return Result<GlyphRun, Error>.success(GlyphRun(self, data))
                    }
                }
            }
        }
    }

    package func native_handle() uint { return self.instance_handle }
    package func native_shape_count() int { return Native.instance_shape_count(self.instance_handle) }
    module func cached_coverage(key:str) Coverage? { return self.coverage_cache.find(key) }
    module func cache_coverage(key:str, coverage:Coverage) { self.coverage_cache.insert(key, coverage) }
    package func coverage_cache_byte_count() int { return self.coverage_cache.byte_count() }
    package func coverage_cache_entry_count() int { return self.coverage_cache.entry_count() }
}

public class GlyphRun {
    private var instance_value:Instance
    private let data:GlyphRunData

    module init(instance:Instance, data:GlyphRunData) {
        self.instance_value = instance
        self.data = data
    }

    func instance() Instance { return self.instance_value }
    func text() str { return self.data.text }
    func direction() Direction { return self.data.direction }
    func script() str { return self.data.script }
    func language() str { return self.data.language }
    func glyphs() Glyph[] { return self.data.glyphs }
    func metrics() RunMetrics { return self.data.metrics }
    func glyph_count() int { return self.data.glyphs.count() }

    func missing_glyph_count() int {
        var count = 0
        for glyph in self.data.glyphs {
            if glyph.is_notdef() { count++ }
        }
        return count
    }

    func place_clusters(
        starts:int[],
        origins:Position[],
        advance:Position
    ) Result<GlyphRun, Error> {
        if starts.count() != origins.count() {
            return Result<GlyphRun, Error>.failure(Error(
                kind:ErrorKind.invalid_placement,
                detail:"font cluster placement requires one origin per cluster start"
            ))
        }
        let bytes = UTF8.bytes(self.data.text)
        if bytes.count() > 0 && (starts.count() == 0 || starts[0] != 0) {
            return Result<GlyphRun, Error>.failure(Error(
                kind:ErrorKind.invalid_placement,
                detail:"font cluster placement must begin at byte zero"
            ))
        }
        var start_index = 0
        while start_index < starts.count() {
            if starts[start_index] < 0 || starts[start_index] >= bytes.count() ||
                !scalar_boundary(bytes, starts[start_index]) ||
                (start_index > 0 && starts[start_index] <= starts[start_index - 1])
            {
                return Result<GlyphRun, Error>.failure(Error(
                    kind:ErrorKind.invalid_placement,
                    detail:"font cluster placement starts must be ordered UTF-8 boundaries"
                ))
            }
            start_index++
        }

        var base_x:float64[] = []
        var base_y:float64[] = []
        var base_set:bool[] = []
        for start in starts {
            base_x.append(0.0)
            base_y.append(0.0)
            base_set.append(false)
        }
        for glyph in self.data.glyphs {
            let cluster_index = placement_cluster_index(starts, glyph.cluster_start)
            if cluster_index >= 0 && !base_set[cluster_index] {
                base_x[cluster_index] = glyph.origin_x
                base_y[cluster_index] = glyph.origin_y
                base_set[cluster_index] = true
            }
        }

        var glyphs:Glyph[] = []
        var ink:Bounds? = null
        for glyph in self.data.glyphs {
            let cluster_index = placement_cluster_index(starts, glyph.cluster_start)
            if cluster_index < 0 {
                return Result<GlyphRun, Error>.failure(Error(
                    kind:ErrorKind.invalid_placement,
                    detail:"font glyph cluster has no requested placement"
                ))
            }
            let shift_x = origins[cluster_index].x - base_x[cluster_index]
            let shift_y = origins[cluster_index].y - base_y[cluster_index]
            var shifted_ink:Bounds? = null
            if bounds = glyph.ink {
                let shifted = Bounds(
                    x:bounds.x + shift_x,
                    y:bounds.y + shift_y,
                    width:bounds.width,
                    height:bounds.height
                )
                shifted_ink = shifted
                ink = combined_bounds(ink, shifted)
            }
            glyphs.append(Glyph(
                id:glyph.id,
                cluster_start:glyph.cluster_start,
                cluster_end:glyph.cluster_end,
                advance_x:glyph.advance_x,
                advance_y:glyph.advance_y,
                offset_x:glyph.offset_x,
                offset_y:glyph.offset_y,
                origin_x:glyph.origin_x + shift_x,
                origin_y:glyph.origin_y + shift_y,
                ink:shifted_ink
            ))
        }
        let line = self.instance_value.metrics()
        return Result<GlyphRun, Error>.success(GlyphRun(self.instance_value, GlyphRunData(
            cache_key:self.data.cache_key + "|placed",
            cache_coverage:false,
            text:self.data.text,
            direction:self.data.direction,
            script:self.data.script,
            language:self.data.language,
            glyphs:glyphs,
            metrics:RunMetrics(
                advance:advance,
                logical_bounds:Bounds(
                    x:Math.min(0.0, advance.x),
                    y:line.descender,
                    width:Math.abs(advance.x),
                    height:line.line_height
                ),
                ink_bounds:ink,
                baseline:0.0,
                ascender:line.ascender,
                descender:line.descender,
                line_height:line.line_height
            )
        )))
    }

    func outlines() Result<PlacedOutline[], Error> {
        var result:PlacedOutline[] = []
        let size = self.instance_value.size()
        for glyph in self.data.glyphs {
            match self.instance_value.outline(glyph.id) {
                failure(error) => { return Result<PlacedOutline[], Error>.failure(error) }
                success(outline) => {
                    result.append(PlacedOutline(
                        glyph_id:glyph.id,
                        outline:outline,
                        origin:glyph.origin(),
                        offset:glyph.offset(),
                        cluster:glyph.cluster(),
                        transform:OutlineTransform(
                            xx:size,
                            xy:0.0,
                            yx:0.0,
                            yy:size,
                            dx:glyph.origin_x,
                            dy:glyph.origin_y
                        )
                    ))
                }
            }
        }
        return Result<PlacedOutline[], Error>.success(result)
    }

    func rasterize(options:RasterOptions = RasterOptions()) Result<Coverage, Error> {
        return rasterize_run(self.instance_value, self.data, options)
    }
}

func rasterize_run(instance:Instance, data:GlyphRunData, options:RasterOptions) Result<Coverage, Error> {
    if options.density <= 0.0 || !Math.is_finite(options.density) {
        return Result<Coverage, Error>.failure(Error(
            kind:ErrorKind.invalid_density,
            detail:"font raster density must be positive and finite"
        ))
    }
    if options.padding < 0 || options.padding > 4096 {
        return Result<Coverage, Error>.failure(Error(
            kind:ErrorKind.invalid_padding,
            detail:"font raster padding must be between zero and 4096 physical pixels"
        ))
    }
    if options.maximum_pixels <= 0 {
        return Result<Coverage, Error>.failure(Error(
            kind:ErrorKind.coverage_too_large,
            detail:"font raster maximum_pixels must be positive"
        ))
    }
    let physical_size_value = instance.size() * options.density * 64.0
    if !Math.is_finite(physical_size_value) ||
        physical_size_value < 1.0 || physical_size_value > 1048576.0 {
        return Result<Coverage, Error>.failure(Error(
            kind:ErrorKind.invalid_density,
            detail:"font raster physical size must fit the supported 1/64-pixel range"
        ))
    }
    let physical_size = Math.round(physical_size_value) as int
    let hinting = hinting_code(options.hinting)
    let antialiasing = antialiasing_code(options.antialiasing)
    let key = data.cache_key + "|density=$(options.density)|hint=$(hinting)|aa=$(antialiasing)|pad=$(options.padding)"
    if data.cache_coverage {
        if cached = instance.cached_coverage(key) {
            if cached.byte_count() > options.maximum_pixels {
                return Result<Coverage, Error>.failure(Error(
                    kind:ErrorKind.coverage_too_large,
                    detail:"cached font coverage exceeds maximum_pixels"
                ))
            }
            return Result<Coverage, Error>.success(cached)
        }
    }

    var glyphs:Native.RasterGlyph[] = []
    for glyph in data.glyphs {
        let pixel_origin_x_value = glyph.origin_x * options.density
        let pixel_origin_y_value = glyph.origin_y * options.density
        if !Math.is_finite(pixel_origin_x_value) || !Math.is_finite(pixel_origin_y_value) ||
            pixel_origin_x_value < -1000000000.0 || pixel_origin_x_value > 1000000000.0 ||
            pixel_origin_y_value < -1000000000.0 || pixel_origin_y_value > 1000000000.0 {
            return Result<Coverage, Error>.failure(Error(
                kind:ErrorKind.coverage_too_large,
                detail:"font raster placement exceeds the portable coordinate range"
            ))
        }
        let pixel_origin_x = Math.round(pixel_origin_x_value) as int
        let pixel_origin_y = Math.round(pixel_origin_y_value) as int
        glyphs.append(Native.RasterGlyph(
            id:glyph.id,
            origin_x:pixel_origin_x,
            origin_y:pixel_origin_y
        ))
    }

    match Native.raster_coverage(
        instance.native_handle(),
        glyphs,
        physical_size,
        hinting,
        antialiasing,
        options.padding,
        options.maximum_pixels
    ) {
        failure(error) => {
            match error.kind {
                invalid_input => {
                    return Result<Coverage, Error>.failure(Error(
                        kind:ErrorKind.coverage_too_large,
                        detail:error.detail
                    ))
                }
                else => { return Result<Coverage, Error>.failure(public_error(error)) }
            }
        }
        success(native) => {
            var bounds = Bounds(x:0.0, y:0.0, width:0.0, height:0.0)
            if native.width > 0 && native.height > 0 {
                let ink_width = native.width - options.padding * 2
                let ink_height = native.height - options.padding * 2
                bounds = Bounds(
                    x:(native.origin_x + options.padding) as float64 / options.density,
                    y:(native.origin_y - options.padding - ink_height) as float64 / options.density,
                    width:ink_width as float64 / options.density,
                    height:ink_height as float64 / options.density
                )
            }
            let coverage = Coverage(
                packed_alpha:native.pixels,
                width:native.width,
                height:native.height,
                stride:native.stride,
                origin:PixelPosition(x:native.origin_x, y:native.origin_y),
                baseline:native.origin_y,
                bounds:bounds,
                advance:data.metrics.advance,
                density:options.density
            )
            if data.cache_coverage { instance.cache_coverage(key, coverage) }
            return Result<Coverage, Error>.success(coverage)
        }
    }
}

func hinting_code(hinting:Hinting) int {
    return match hinting { none => 0; light => 1; normal => 2 }
}

func antialiasing_code(antialiasing:Antialiasing) int {
    return match antialiasing { grayscale => 0; monochrome => 1 }
}

func normalized_outline(glyph_id:uint32, data:Native.OutlineData, units_per_em:int) GlyphOutline {
    let scale = units_per_em as float64
    var contours:OutlineContour[] = []
    var current:OutlineStep[] = []
    for step in data.steps {
        let first = Position(x:step.x1 as float64 / scale, y:step.y1 as float64 / scale)
        let second = Position(x:step.x2 as float64 / scale, y:step.y2 as float64 / scale)
        let third = Position(x:step.x3 as float64 / scale, y:step.y3 as float64 / scale)
        if step.kind == 1 { current.append(OutlineStep.move_to(first)) }
        if step.kind == 2 { current.append(OutlineStep.line_to(first)) }
        if step.kind == 3 { current.append(OutlineStep.quadratic_to(QuadraticCurve(control:first, endpoint:second))) }
        if step.kind == 4 { current.append(OutlineStep.cubic_to(CubicCurve(control_1:first, control_2:second, endpoint:third))) }
        if step.kind == 5 {
            current.append(OutlineStep.close())
            contours.append(OutlineContour(steps:current))
            current = []
        }
    }
    return GlyphOutline(
        glyph_id:glyph_id,
        contours:contours,
        bounds:Bounds(
            x:data.x_min as float64 / scale,
            y:data.y_min as float64 / scale,
            width:(data.x_max - data.x_min) as float64 / scale,
            height:(data.y_max - data.y_min) as float64 / scale
        ),
        advance:Position(
            x:data.x_advance as float64 / scale,
            y:data.y_advance as float64 / scale
        ),
        fill_rule:FillRule.non_zero()
    )
}

func validated_shape(text:str, options:ShapeOptions) Result<ValidatedShape, Error> {
    if default_shape_options(options) {
        let byte_count = C.byte_count(text) as int
        var index:uint = 0
        while index < byte_count as uint {
            let byte = C.byte_at(text, index)
            if byte == 10 || byte == 13 {
                return Result<ValidatedShape, Error>.failure(Error(
                    kind:ErrorKind.invalid_text,
                    detail:"font shaping accepts one homogeneous run without line breaks"
                ))
            }
            index++
        }
        return Result<ValidatedShape, Error>.success(ValidatedShape(
            key:"$(byte_count):" + text,
            direction:0,
            script:"",
            language:"und",
            features:[]
        ))
    }
    let text_bytes = UTF8.bytes(text)
    for byte in text_bytes {
        if byte == 10 || byte == 13 {
            return Result<ValidatedShape, Error>.failure(Error(
                kind:ErrorKind.invalid_text,
                detail:"font shaping accepts one homogeneous run without line breaks"
            ))
        }
    }

    var script = ""
    if value = options.script { script = value }
    if script != "" {
        let bytes = UTF8.bytes(script)
        if bytes.count() != 4 || !ascii_letters(bytes) {
            return Result<ValidatedShape, Error>.failure(Error(
                kind:ErrorKind.invalid_tag,
                detail:"font shaping scripts use four-letter ISO 15924 tags"
            ))
        }
    }

    var language = "und"
    if value = options.language { language = value }
    if !valid_language(language) {
        return Result<ValidatedShape, Error>.failure(Error(
            kind:ErrorKind.invalid_language,
            detail:"font shaping language must be a non-empty BCP 47 or HarfBuzz-compatible tag"
        ))
    }

    let direction = direction_code(options.direction)
    var native_features:Native.ShapeFeature[] = []
    // This key never crosses a trust boundary: retaining the text with its
    // byte length is collision-free and avoids a cryptographic digest on every
    // cold line shaped by editors and terminals.
    var key = "$(text_bytes.count()):" + text +
        "|d=$(direction)|s=$(script)|l=$(language)"
    for feature in options.features {
        let tag_bytes = UTF8.bytes(feature.tag)
        if tag_bytes.count() != 4 || !printable_ascii(tag_bytes) {
            return Result<ValidatedShape, Error>.failure(Error(
                kind:ErrorKind.invalid_tag,
                detail:"OpenType feature tags must contain exactly four printable ASCII bytes"
            ))
        }
        if feature.value < 0 || feature.value > 4294967295 {
            return Result<ValidatedShape, Error>.failure(Error(
                kind:ErrorKind.invalid_feature_range,
                detail:"OpenType feature values must fit an unsigned 32-bit integer"
            ))
        }
        var end = feature.end
        if end == -1 { end = text_bytes.count() }
        if feature.start < 0 || end < feature.start || end > text_bytes.count() ||
            !scalar_boundary(text_bytes, feature.start) || !scalar_boundary(text_bytes, end) {
            return Result<ValidatedShape, Error>.failure(Error(
                kind:ErrorKind.invalid_feature_range,
                detail:"OpenType feature ranges use ordered UTF-8 byte offsets on scalar boundaries"
            ))
        }
        let tag = Native.tag(feature.tag)
        native_features.append(Native.ShapeFeature(
            tag:tag,
            value:feature.value as uint32,
            start:feature.start as uint32,
            end:end as uint32
        ))
        key = key + "|f=$(tag):$(feature.value):$(feature.start):$(end)"
    }
    return Result<ValidatedShape, Error>.success(ValidatedShape(
        key:key,
        direction:direction,
        script:script,
        language:language,
        features:native_features
    ))
}

func default_shape_options(options:@ShapeOptions) bool {
    if direction = options.direction { return false }
    if script = options.script { return false }
    if language = options.language { return false }
    return options.features.count() == 0
}

func glyph_run_data(instance:Instance, cache_key:str, text:str, shaped:Native.ShapeData) GlyphRunData {
    let upem = instance.face().units_per_em() as float64
    let scale = instance.size() / upem
    var glyphs:Glyph[] = []
    var run_ink:Bounds? = null
    for shaped_glyph in shaped.glyphs {
        var ink:Bounds? = null
        if shaped_glyph.has_ink {
            let first_x = (shaped_glyph.x_origin + shaped_glyph.x_bearing) as float64 * scale
            let first_y = (shaped_glyph.y_origin + shaped_glyph.y_bearing) as float64 * scale
            let second_x = first_x + shaped_glyph.width as float64 * scale
            let second_y = first_y + shaped_glyph.height as float64 * scale
            let bounds = Bounds(
                x:Math.min(first_x, second_x),
                y:Math.min(first_y, second_y),
                width:Math.abs(second_x - first_x),
                height:Math.abs(second_y - first_y)
            )
            ink = bounds
            run_ink = combined_bounds(run_ink, bounds)
        }
        glyphs.append(Glyph(
            id:shaped_glyph.id,
            cluster_start:shaped_glyph.cluster_start,
            cluster_end:shaped_glyph.cluster_end,
            advance_x:shaped_glyph.x_advance as float64 * scale,
            advance_y:shaped_glyph.y_advance as float64 * scale,
            offset_x:shaped_glyph.x_offset as float64 * scale,
            offset_y:shaped_glyph.y_offset as float64 * scale,
            origin_x:shaped_glyph.x_origin as float64 * scale,
            origin_y:shaped_glyph.y_origin as float64 * scale,
            ink:ink
        ))
    }

    let direction = public_direction(shaped.direction)
    let advance = Position(
        x:shaped.x_advance as float64 * scale,
        y:shaped.y_advance as float64 * scale
    )
    let line = instance.metrics()
    var logical = Bounds(
        x:Math.min(0.0, advance.x),
        y:line.descender,
        width:Math.abs(advance.x),
        height:line.line_height
    )
    if shaped.direction == 3 || shaped.direction == 4 {
        logical = Bounds(
            x:line.descender,
            y:Math.min(0.0, advance.y),
            width:line.line_height,
            height:Math.abs(advance.y)
        )
    }
    return GlyphRunData(
        cache_key:cache_key,
        text:text,
        direction:direction,
        script:shaped.script,
        language:shaped.language,
        glyphs:glyphs,
        metrics:RunMetrics(
            advance:advance,
            logical_bounds:logical,
            ink_bounds:run_ink,
            baseline:0.0,
            ascender:line.ascender,
            descender:line.descender,
            line_height:line.line_height
        )
    )
}

func combined_bounds(current:Bounds?, next:Bounds) Bounds? {
    if value = current {
        let minimum_x = Math.min(value.x, next.x)
        let minimum_y = Math.min(value.y, next.y)
        let maximum_x = Math.max(value.x + value.width, next.x + next.width)
        let maximum_y = Math.max(value.y + value.height, next.y + next.height)
        return Bounds(
            x:minimum_x,
            y:minimum_y,
            width:maximum_x - minimum_x,
            height:maximum_y - minimum_y
        )
    }
    return next
}

func direction_code(direction:Direction?) int {
    if value = direction {
        match value {
            left_to_right => { return 1 }
            right_to_left => { return 2 }
            top_to_bottom => { return 3 }
            bottom_to_top => { return 4 }
        }
    }
    return 0
}

func public_direction(value:int) Direction {
    if value == 2 { return Direction.right_to_left() }
    if value == 3 { return Direction.top_to_bottom() }
    if value == 4 { return Direction.bottom_to_top() }
    return Direction.left_to_right()
}

func scalar_boundary(bytes:uint8[], offset:int) bool {
    if offset == bytes.count() { return true }
    if offset < 0 || offset > bytes.count() { return false }
    return bytes[offset] < 128 || bytes[offset] > 191
}

func placement_cluster_index(starts:@int[], byte_offset:int) int {
    var first = 0
    var last = starts.count()
    while first < last {
        let middle = first + (last - first) / 2
        if starts[middle] <= byte_offset { first = middle + 1 }
        else { last = middle }
    }
    return first - 1
}

func ascii_letters(bytes:uint8[]) bool {
    for byte in bytes {
        if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) { return false }
    }
    return true
}

func printable_ascii(bytes:uint8[]) bool {
    for byte in bytes {
        if byte < 32 || byte > 126 { return false }
    }
    return true
}

func valid_language(language:str) bool {
    let bytes = UTF8.bytes(language)
    if bytes.count() == 0 || bytes.count() >= 64 { return false }
    if bytes[0] == 45 || bytes[0] == 95 || bytes[-1] == 45 || bytes[-1] == 95 { return false }
    var previous_separator = false
    for byte in bytes {
        let alphanumeric = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
        let separator = byte == 45 || byte == 95
        if !alphanumeric && !separator { return false }
        if separator && previous_separator { return false }
        previous_separator = separator
    }
    return true
}

func validated_variations(face:Face, requested:Variation[]) Result<Variation[], Error> {
    var index = 0
    while index < requested.count() {
        let bytes = UTF8.bytes(requested[index].tag)
        if bytes.count() != 4 {
            return Result<Variation[], Error>.failure(Error(
                kind:ErrorKind.invalid_tag,
                detail:"OpenType variation tags must contain exactly four UTF-8 bytes"
            ))
        }
        if !Math.is_finite(requested[index].value) {
            return Result<Variation[], Error>.failure(Error(
                kind:ErrorKind.variation_out_of_range,
                detail:"variation coordinate values must be finite"
            ))
        }
        var previous = 0
        while previous < index {
            if requested[previous].tag == requested[index].tag {
                return Result<Variation[], Error>.failure(Error(
                    kind:ErrorKind.duplicate_axis,
                    detail:"variation axis $(requested[index].tag) was provided more than once"
                ))
            }
            previous++
        }
        index++
    }

    let axes = face.axes()
    for variation in requested {
        var matched = false
        for axis in axes {
            if axis.tag == variation.tag {
                matched = true
                if variation.value < axis.minimum || variation.value > axis.maximum {
                    return Result<Variation[], Error>.failure(Error(
                        kind:ErrorKind.variation_out_of_range,
                        detail:"variation axis $(axis.tag) accepts values from $(axis.minimum) to $(axis.maximum)"
                    ))
                }
            }
        }
        if !matched {
            return Result<Variation[], Error>.failure(Error(
                kind:ErrorKind.unknown_axis,
                detail:"font face does not expose variation axis $(variation.tag)"
            ))
        }
    }

    var effective:Variation[] = []
    for axis in axes {
        var value = axis.default_value
        for variation in requested {
            if variation.tag == axis.tag { value = variation.value }
        }
        effective.append(Variation(axis.tag, value))
    }
    return Result<Variation[], Error>.success(effective)
}

func instance_identity(face:Face, size:float64, variations:Variation[], synthesis:Synthesis) str {
    var result = face.identity() + "|size=$(size)"
    for variation in variations { result = result + "|$(variation.tag)=$(variation.value)" }
    if synthesis.embolden { result = result + "|embolden" }
    if synthesis.oblique { result = result + "|oblique" }
    return result
}

func optional_text(value:str) str? {
    if value == "" { return null }
    return value
}

func public_error(error:Native.Error) Error {
    var kind = ErrorKind.native_failure
    match error.kind {
        empty_data => { kind = ErrorKind.empty_data }
        invalid_data => { kind = ErrorKind.invalid_data }
        face_index_out_of_range => { kind = ErrorKind.face_index_out_of_range }
        out_of_memory => { kind = ErrorKind.out_of_memory }
        unsupported => { kind = ErrorKind.unsupported }
        abi_mismatch => { kind = ErrorKind.abi_mismatch }
        invalid_input => { kind = ErrorKind.invalid_text }
        native_failure => { kind = ErrorKind.native_failure }
    }
    return Error(kind:kind, detail:error.detail)
}
