package func abi_pointer_size_value() int { return abi_pointer_size() as int }
package func abi_size_size_value() int { return abi_size_size() as int }
package func abi_pointer_alignment_value() int { return abi_pointer_alignment() as int }
package func live_library_count() int { return boundary_live_library_count() as int }
package func live_face_count() int { return boundary_live_face_count() as int }
package func live_instance_count() int { return boundary_live_instance_count() as int }
package func live_outline_count() int { return boundary_live_outline_count() as int }
package func live_bitmap_count() int { return boundary_live_bitmap_count() as int }
package func live_coverage_count() int { return boundary_live_coverage_count() as int }
package func instance_shape_count(handle:uint) int { return boundary_instance_shape_count(C.pointer_bits(handle)) as int }
package func face_outline_decomposition_count(handle:uint) int { return boundary_face_outline_decomposition_count(C.pointer_bits(handle)) as int }
package func fail_outline_after_for_test(step_count:int) { boundary_fail_outline_after(step_count as uint32) }
package func face_bitmap_rasterization_count(handle:uint) int { return boundary_face_bitmap_rasterization_count(C.pointer_bits(handle)) as int }
package func face_bitmap_cache_entry_count(handle:uint) int { return boundary_face_bitmap_cache_entry_count(C.pointer_bits(handle)) as int }
package func face_bitmap_cache_byte_count(handle:uint) int { return boundary_face_bitmap_cache_byte_count(C.pointer_bits(handle)) as int }

package func rejects_invalid_utf8_for_test(handle:uint) bool {
    let invalid:uint8[] = [195 as uint8, 40 as uint8]
    let packed = C.string(@invalid[0:invalid.count()])
    let raw = C.address_bits(shape_create(
        C.pointer_bits(handle), C.pointer(packed), C.byte_count(packed), 1 as int32,
        0 as uint32, C.pointer("und"), C.byte_count("und")
    ))
    if raw != 0 as uint {
        shape_destroy(C.pointer_bits(raw))
        return false
    }
    return boundary_last_error_code() == 8
}

func verify_abi() Result<void, Error> {
    if abi_version() != 5 as uint32 {
        return Result<void, Error>.failure(Error(kind:ErrorKind.abi_mismatch, detail:"GFX.Font expected native ABI version 5"))
    }
    if abi_pointer_size() != 8 as uint32 || abi_size_size() != 8 as uint32 || abi_pointer_alignment() != 8 as uint32 {
        return Result<void, Error>.failure(Error(kind:ErrorKind.abi_mismatch, detail:"GFX.Font requires the 64-bit Silex ABI layout"))
    }
    return Result<void, Error>.success()
}

func last_error() Error {
    let code = boundary_last_error_code()
    var kind = ErrorKind.native_failure
    if code == 1 { kind = ErrorKind.empty_data }
    if code == 2 { kind = ErrorKind.invalid_data }
    if code == 3 { kind = ErrorKind.face_index_out_of_range }
    if code == 4 { kind = ErrorKind.out_of_memory }
    if code == 5 { kind = ErrorKind.unsupported }
    if code == 6 { kind = ErrorKind.abi_mismatch }
    if code == 8 { kind = ErrorKind.invalid_input }
    return Error(kind:kind, detail:copy_text(boundary_last_error_detail()))
}

func copy_text(pointer:C.Pointer<uint8>) str {
    let address = C.address_bits(pointer)
    if address == 0 as uint { return "" }
    var bytes:uint8[] = []
    var index = 0
    while index < 4096 {
        let byte = C.load<uint8>(address, index as uint)
        if byte == 0 { return C.string(@bytes[0:bytes.count()]) }
        bytes.append(byte)
        index++
    }
    return "invalid native UTF-8 detail"
}

func signed32(value:int32) int {
    let bits = value as uint32
    if bits > 2147483647 as uint32 { return bits as int - 4294967296 }
    return bits as int
}

let abi_version = C.function<func() uint32>(library:Boundary.FontBoundary, name:"silex_font_abi_version")
let abi_pointer_size = C.function<func() uint32>(library:Boundary.FontBoundary, name:"silex_font_abi_pointer_size")
let abi_size_size = C.function<func() uint32>(library:Boundary.FontBoundary, name:"silex_font_abi_size_size")
let abi_pointer_alignment = C.function<func() uint32>(library:Boundary.FontBoundary, name:"silex_font_abi_pointer_alignment")
let library_create = C.function<func() C.Pointer<uint8> >(library:Boundary.FontBoundary, name:"silex_font_library_create")
let library_destroy = C.function<func(C.Pointer<uint8>) void>(library:Boundary.FontBoundary, name:"silex_font_library_destroy")
let face_create = C.function<func(C.Pointer<uint8>, C.Pointer<uint8>, C.Size, int32) C.Pointer<uint8> >(library:Boundary.FontBoundary, name:"silex_font_face_create")
let face_destroy = C.function<func(C.Pointer<uint8>) void>(library:Boundary.FontBoundary, name:"silex_font_face_destroy")
let face_index = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_index")
let face_count = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_count")
let face_glyph_count = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_glyph_count")
let face_units_per_em = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_units_per_em")
let face_capabilities = C.function<func(C.Pointer<uint8>) uint32>(library:Boundary.FontBoundary, name:"silex_font_face_capabilities")
let face_outline_kind = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_outline_kind")
let face_family_name = C.function<func(C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.FontBoundary, name:"silex_font_face_family_name")
let face_subfamily_name = C.function<func(C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.FontBoundary, name:"silex_font_face_subfamily_name")
let face_postscript_name = C.function<func(C.Pointer<uint8>) C.Pointer<uint8> >(library:Boundary.FontBoundary, name:"silex_font_face_postscript_name")
let face_supports_scalar = C.function<func(C.Pointer<uint8>, uint32) int32>(library:Boundary.FontBoundary, name:"silex_font_face_supports_scalar")
let face_ascender = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_ascender")
let face_descender = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_descender")
let face_line_gap = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_line_gap")
let face_line_height = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_line_height")
let face_underline_position = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_underline_position")
let face_underline_thickness = C.function<func(C.Pointer<uint8>) int32>(library:Boundary.FontBoundary, name:"silex_font_face_underline_thickness")
