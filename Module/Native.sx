use Interop.Boundary
use Interop.C

package enum ErrorKind {
    empty_data
    invalid_data
    face_index_out_of_range
    out_of_memory
    unsupported
    abi_mismatch
    invalid_input
    native_failure
}

package struct Error {
    let kind:ErrorKind
    let detail:str
}

package struct FaceData { let library:uint; let face:uint }
package struct Bounds { let x:float64; let y:float64; let width:float64; let height:float64 }
package struct ShapeFeature { let tag:uint32; let value:uint32; let start:uint32; let end:uint32 }
package struct ShapedGlyph {
    let id:uint32
    let cluster_start:int
    let cluster_end:int
    let x_advance:int
    let y_advance:int
    let x_offset:int
    let y_offset:int
    let x_origin:int
    let y_origin:int
    let has_ink:bool
    let x_bearing:int
    let y_bearing:int
    let width:int
    let height:int
}
package struct ShapeData {
    let direction:int
    let script:str
    let language:str
    let glyphs:ShapedGlyph[]
    let x_advance:int
    let y_advance:int
}

package func open(bytes:uint8[], face_index:int) Result<FaceData, Error> {
    match verify_abi() {
        failure(error) => { return Result<FaceData, Error>.failure(error) }
        success => {}
    }
    if bytes.count() == 0 {
        return Result<FaceData, Error>.failure(Error(kind:ErrorKind.empty_data, detail:"font data cannot be empty"))
    }
    if face_index < 0 {
        return Result<FaceData, Error>.failure(Error(kind:ErrorKind.face_index_out_of_range, detail:"font face index cannot be negative"))
    }
    let library = C.address_bits(library_create())
    if library == 0 as uint { return Result<FaceData, Error>.failure(last_error()) }
    let packed = C.string(@bytes[0:bytes.count()])
    let face = C.address_bits(face_create(C.pointer_bits(library), C.pointer(packed), C.byte_count(packed), face_index as int32))
    if face == 0 as uint {
        let error = last_error()
        library_destroy(C.pointer_bits(library))
        return Result<FaceData, Error>.failure(error)
    }
    return Result<FaceData, Error>.success(FaceData(library:library, face:face))
}

package func close_face(library:uint, face:uint) {
    face_destroy(C.pointer_bits(face))
    library_destroy(C.pointer_bits(library))
}

package func create_instance(face:uint) Result<uint, Error> {
    let handle = C.address_bits(instance_create(C.pointer_bits(face)))
    if handle == 0 as uint { return Result<uint, Error>.failure(last_error()) }
    return Result<uint, Error>.success(handle)
}

package func set_variation(handle:uint, tag_value:uint32, value:float64) Result<void, Error> {
    if instance_set_variation(C.pointer_bits(handle), tag_value, value as float32) == 0 {
        return Result<void, Error>.failure(last_error())
    }
    return Result<void, Error>.success()
}

package func close_instance(handle:uint) { instance_destroy(C.pointer_bits(handle)) }

package func index(handle:uint) int { return face_index(C.pointer_bits(handle)) as int }
package func count(handle:uint) int { return face_count(C.pointer_bits(handle)) as int }
package func glyph_count(handle:uint) int { return face_glyph_count(C.pointer_bits(handle)) as int }
package func units_per_em(handle:uint) int { return face_units_per_em(C.pointer_bits(handle)) as int }
package func capabilities(handle:uint) uint { return face_capabilities(C.pointer_bits(handle)) as uint }
package func outline_kind(handle:uint) int { return face_outline_kind(C.pointer_bits(handle)) as int }
package func family_name(handle:uint) str { return copy_text(face_family_name(C.pointer_bits(handle))) }
package func subfamily_name(handle:uint) str { return copy_text(face_subfamily_name(C.pointer_bits(handle))) }
package func postscript_name(handle:uint) str { return copy_text(face_postscript_name(C.pointer_bits(handle))) }
package func supports_scalar(handle:uint, scalar:uint32) bool { return face_supports_scalar(C.pointer_bits(handle), scalar) != 0 }

package func ascender(handle:uint) int { return signed32(face_ascender(C.pointer_bits(handle))) }
package func descender(handle:uint) int { return signed32(face_descender(C.pointer_bits(handle))) }
package func line_gap(handle:uint) int { return signed32(face_line_gap(C.pointer_bits(handle))) }
package func line_height(handle:uint) int { return signed32(face_line_height(C.pointer_bits(handle))) }
package func underline_position(handle:uint) int { return signed32(face_underline_position(C.pointer_bits(handle))) }
package func underline_thickness(handle:uint) int { return signed32(face_underline_thickness(C.pointer_bits(handle))) }
package func strikeout_position(handle:uint) int { return signed32(face_strikeout_position(C.pointer_bits(handle))) }
package func strikeout_thickness(handle:uint) int { return signed32(face_strikeout_thickness(C.pointer_bits(handle))) }

package func axis_count(handle:uint) int { return face_axis_count(C.pointer_bits(handle)) as int }
package func axis_tag(handle:uint, index:int) str { return copy_text(tag_text(face_axis_tag(C.pointer_bits(handle), index as uint32))) }
package func axis_name(handle:uint, index:int) str { return copy_text(face_axis_name(C.pointer_bits(handle), index as uint32)) }
package func axis_minimum(handle:uint, index:int) float64 { return face_axis_minimum(C.pointer_bits(handle), index as uint32) as float64 }
package func axis_default(handle:uint, index:int) float64 { return face_axis_default(C.pointer_bits(handle), index as uint32) as float64 }
package func axis_maximum(handle:uint, index:int) float64 { return face_axis_maximum(C.pointer_bits(handle), index as uint32) as float64 }

package func named_instance_count(handle:uint) int { return face_named_instance_count(C.pointer_bits(handle)) as int }
package func named_instance_name(handle:uint, index:int) str { return copy_text(face_named_instance_name(C.pointer_bits(handle), index as uint32)) }
package func named_instance_postscript_name(handle:uint, index:int) str { return copy_text(face_named_instance_postscript_name(C.pointer_bits(handle), index as uint32)) }
package func named_instance_coordinate(handle:uint, instance_index:int, axis_index:int) float64 {
    return face_named_instance_coordinate(C.pointer_bits(handle), instance_index as uint32, axis_index as uint32) as float64
}

package func tag(value:str) uint32 { return tag_from_bytes(C.pointer(value)) }

package func scalar_bounds(handle:uint, scalar:uint32, units_per_em:int) Bounds? {
    var x:int32 = 0
    var y:int32 = 0
    var width:int32 = 0
    var height:int32 = 0
    if instance_scalar_bounds(
        C.pointer_bits(handle), scalar, C.mutable_pointer(x), C.mutable_pointer(y),
        C.mutable_pointer(width), C.mutable_pointer(height)
    ) == 0 { return null }
    let scale = units_per_em as float64
    return Bounds(
        x:signed32(x) as float64 / scale,
        y:signed32(y) as float64 / scale,
        width:signed32(width) as float64 / scale,
        height:signed32(height) as float64 / scale
    )
}

package func shape(
    handle:uint,
    text:str,
    direction:int,
    script:str,
    language:str,
    features:ShapeFeature[]
) Result<ShapeData, Error> {
    var script_tag:uint32 = 0 as uint32
    if script != "" { script_tag = tag(script) }
    let raw = C.address_bits(shape_create(
        C.pointer_bits(handle), C.pointer(text), C.byte_count(text), direction as int32,
        script_tag, C.pointer(language), C.byte_count(language)
    ))
    if raw == 0 as uint { return Result<ShapeData, Error>.failure(last_error()) }
    for feature in features {
        if shape_add_feature(
            C.pointer_bits(raw), feature.tag, feature.value, feature.start, feature.end
        ) == 0 {
            let error = last_error()
            shape_destroy(C.pointer_bits(raw))
            return Result<ShapeData, Error>.failure(error)
        }
    }
    if shape_finish(C.pointer_bits(raw)) == 0 {
        let error = last_error()
        shape_destroy(C.pointer_bits(raw))
        return Result<ShapeData, Error>.failure(error)
    }
    var glyphs:ShapedGlyph[] = []
    var index = 0
    while index < shape_glyph_count(C.pointer_bits(raw)) as int {
        glyphs.append(ShapedGlyph(
            id:shape_glyph_id(C.pointer_bits(raw), index as uint32),
            cluster_start:shape_glyph_cluster_start(C.pointer_bits(raw), index as uint32) as int,
            cluster_end:shape_glyph_cluster_end(C.pointer_bits(raw), index as uint32) as int,
            x_advance:signed32(shape_glyph_x_advance(C.pointer_bits(raw), index as uint32)),
            y_advance:signed32(shape_glyph_y_advance(C.pointer_bits(raw), index as uint32)),
            x_offset:signed32(shape_glyph_x_offset(C.pointer_bits(raw), index as uint32)),
            y_offset:signed32(shape_glyph_y_offset(C.pointer_bits(raw), index as uint32)),
            x_origin:signed32(shape_glyph_x_origin(C.pointer_bits(raw), index as uint32)),
            y_origin:signed32(shape_glyph_y_origin(C.pointer_bits(raw), index as uint32)),
            has_ink:shape_glyph_has_ink(C.pointer_bits(raw), index as uint32) != 0,
            x_bearing:signed32(shape_glyph_x_bearing(C.pointer_bits(raw), index as uint32)),
            y_bearing:signed32(shape_glyph_y_bearing(C.pointer_bits(raw), index as uint32)),
            width:signed32(shape_glyph_width(C.pointer_bits(raw), index as uint32)),
            height:signed32(shape_glyph_height(C.pointer_bits(raw), index as uint32))
        ))
        index++
    }
    let result = ShapeData(
        direction:shape_direction(C.pointer_bits(raw)) as int,
        script:copy_text(tag_text(shape_script(C.pointer_bits(raw)))),
        language:copy_text(shape_language(C.pointer_bits(raw))),
        glyphs:glyphs,
        x_advance:signed32(shape_x_advance(C.pointer_bits(raw))),
        y_advance:signed32(shape_y_advance(C.pointer_bits(raw)))
    )
    shape_destroy(C.pointer_bits(raw))
    return Result<ShapeData, Error>.success(result)
}

package func abi_version_value() int { return abi_version() as int }
package func abi_pointer_size_value() int { return abi_pointer_size() as int }
package func abi_size_size_value() int { return abi_size_size() as int }
package func abi_pointer_alignment_value() int { return abi_pointer_alignment() as int }
package func live_library_count() int { return boundary_live_library_count() as int }
package func live_face_count() int { return boundary_live_face_count() as int }
package func live_instance_count() int { return boundary_live_instance_count() as int }
package func instance_shape_count(handle:uint) int { return boundary_instance_shape_count(C.pointer_bits(handle)) as int }

package func rejects_invalid_utf8_for_test(handle:uint) bool {
    let invalid:uint8[] = [195 as uint8, 40 as uint8]
    let packed = C.string(@invalid[0:invalid.count()])
    let raw = C.address_bits(shape_create(
        C.pointer_bits(handle), C.pointer(packed), C.byte_count(packed), 1 as int32,
        0 as uint32, C.pointer("und"), C.byte_count("und")
    ))
    if raw != 0 as uint {
        shape_destroy(C.pointer_bits(raw))
        return false
    }
    return boundary_last_error_code() == 8
}

func verify_abi() Result<void, Error> {
    if abi_version() != 3 as uint32 {
        return Result<void, Error>.failure(Error(kind:ErrorKind.abi_mismatch, detail:"GFX.Font expected native ABI version 3"))
    }
    if abi_pointer_size() != 8 as uint32 || abi_size_size() != 8 as uint32 || abi_pointer_alignment() != 8 as uint32 {
        return Result<void, Error>.failure(Error(kind:ErrorKind.abi_mismatch, detail:"GFX.Font requires the 64-bit Silex ABI layout"))
    }
    return Result<void, Error>.success()
}

func last_error() Error {
    let code = boundary_last_error_code()
    var kind = ErrorKind.native_failure
    if code == 1 { kind = ErrorKind.empty_data }
    if code == 2 { kind = ErrorKind.invalid_data }
    if code == 3 { kind = ErrorKind.face_index_out_of_range }
    if code == 4 { kind = ErrorKind.out_of_memory }
    if code == 5 { kind = ErrorKind.unsupported }
    if code == 6 { kind = ErrorKind.abi_mismatch }
    if code == 8 { kind = ErrorKind.invalid_input }
    return Error(kind:kind, detail:copy_text(boundary_last_error_detail()))
}

func copy_text(pointer:C.Pointer<uint8>) str {
    let address = C.address_bits(pointer)
    if address == 0 as uint { return "" }
    var bytes:uint8[] = []
    var index = 0
    while index < 4096 {
        let byte = C.load<uint8>(address, index as uint)
        if byte == 0 { return C.string(@bytes[0:bytes.count()]) }
        bytes.append(byte)
        index++
    }
    return "invalid native UTF-8 detail"
}

func signed32(value:int32) int {
    let bits = value as uint32
    if bits > 2147483647 as uint32 { return bits as int - 4294967296 }
    return bits as int
}

