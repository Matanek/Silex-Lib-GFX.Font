use GFX.Font
use GFX.Font.Native

test "verify native ABI layout and release all global state" {
    assert(Native.abi_version_value() == 1)
    assert(Native.abi_pointer_size_value() == 8)
    assert(Native.abi_size_size_value() == 8)
    assert(Native.abi_pointer_alignment_value() == 8)
    assert(Native.live_library_count() == 0)
    assert(Native.live_face_count() == 0)

    let bytes = embed_bytes("Fixtures/Minimal.ttf")
    match Font.Face.try_open(bytes) {
        failure(error) => { panic(error.detail) }
        success(face) => {
            assert(Native.live_library_count() == 1)
            assert(Native.live_face_count() == 1)
            assert(face.close())
            assert(Native.live_library_count() == 0)
            assert(Native.live_face_count() == 0)
        }
    }
}
